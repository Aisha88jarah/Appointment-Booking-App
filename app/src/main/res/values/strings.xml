    <string name="client_howto_title">What clients should send</string>
    <string name="client_howto">One request per message, for example:\nName: ...\nService: ...\nDate: 2026-11-05 (or tomorrow / Monday)\nTime: 10:30 or 3:30 pm\nPhone: ...\nNotes: ...\nTip: paste this into BotFather > Edit Bot > Edit Description so clients see it.</string>
    <string name="tpl_confirm">Hello {name},\nYour appointment is confirmed.\nService: {service}\nDate: {date}\nTime: {time}\nDuration: {duration} min\n{business}\n{address}\nIf you need to change or cancel it, please reply to this message.</string>
    <string name="tpl_decline">Hello {name},\nSorry, we are unable to confirm your appointment request for that time. Please send us another date or time and we will do our best to arrange it.\n{business}</string>
    <string name="tpl_reschedule">Hello {name},\nYour appointment has been rescheduled.\nService: {service}\nNew date: {date}\nNew time: {time}\n{business}\n{address}\nPlease reply if this does not suit you.</string>
    <string name="tpl_cancel">Hello {name},\nYour appointment on {date} at {time} has been cancelled. You are welcome to send a new request at any time.\n{business}</string>
